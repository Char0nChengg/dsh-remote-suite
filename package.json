{
  "name": "@char0nchengg/dsh-remote-suite",
  "version": "0.2.0",
  "description": "Remote shell, file, and transfer tools for DeepSeek Harness over local OpenSSH or WSL, with a visual server manager and chat-editable per-server environment notes; no agent on the server and no outbound connection from the server.",
  "license": "MIT",
  "author": "Char0nChengg",
  "homepage": "https://github.com/Char0nChengg/dsh-remote-suite#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Char0nChengg/dsh-remote-suite.git"
  },
  "bugs": {
    "url": "https://github.com/Char0nChengg/dsh-remote-suite/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "ssh",
    "wsl",
    "remote",
    "remote-development"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/**/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "targets.example.yml",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "test": "node --test",
    "check": "node --check index.js && node --check lib/remote.js && node --check client.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.1-rc.3": "compatible"
      }
    }
  }
}
